# TradeBuddy - self-hosted MT4/MT5 account monitor
# Copy to .env and fill in before `docker compose up -d --build`

# --- Required ---
# 32-byte hex secret used to encrypt broker credentials at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Shared secret that agents (TradeBuddy EA / MT5 python agent) and the pull
# collector use when posting to the app's /api/ingest.
# Generate: openssl rand -hex 32
INGEST_TOKEN=change-me-openssl-rand-hex-32

# --- Agent mode (default data path - see agents/README.md) ---
# 1 = the dashboard's "Setup guide" shows your INGEST_TOKEN with copy buttons.
# Keep 0 when people you don't trust can reach the dashboard.
EXPOSE_INGEST_TOKEN=1
# Absolute base URL agents should use (optional; auto-detected from proxy
# headers when unset). Example: https://tradebuddy.example.com
PUBLIC_APP_URL=

# --- Optional (defaults shown) ---
# SQLite database file inside the app container (mounted volume /data).
DATABASE_URL=file:/data/monitor.db

# Minutes between collection cycles (pull mode only).
POLL_MINUTES=5

# Random delay added per cycle so collections don't align exactly (pull mode).
COLLECTION_JITTER_SECONDS=20

# --- Pull mode (docker compose --profile pull up -d) ---
# EXPERIMENTAL: server-side Wine gateways. Agent mode is the reliable path.
# MT4 gateway (single-account convenience login; leave blank for manual GUI login)
MT4_GATEWAY_LOGIN=
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=
# Optional: custom EA history command if you applied the MT4 history patch.
MT4_HISTORY_CMD=
# Shared key the MT4 gateway expects from clients.
MT4_BRIDGE_API_KEY=change-me

# --- Optional overrides ---
# Comma-separated gateway URLs when running multiple MT4 gateways.
# MT4_GATEWAY_URL=http://mt4-gateway:8001
# MT5_GATEWAY_URL=http://mt5-gateway:8002
